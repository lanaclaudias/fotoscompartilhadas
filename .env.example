# Copie este arquivo para ".env" e preencha. NUNCA envie o .env para o GitHub.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-chave-service_role

# Senha do painel dos noivos
ADMIN_PASSWORD=escolha-uma-senha-forte

# Opcional: endereço final do site (ex.: domínio próprio). Se vazio, usa o endereço atual.
# PUBLIC_URL=https://fotos.anaejoao.com.br
